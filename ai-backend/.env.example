PORT=3000

# Copia este archivo como ".env" y pega tu API key de OpenRouter abajo.
# Se obtiene en https://openrouter.ai/keys y empieza con "sk-or-v1-..."
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui

# Modelo a usar (debe soportar "tool calling"). Ejemplos: openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Base de datos Sakila ----
# sqlite (por defecto): usa db/sakila.db incluida en el proyecto, no hay que instalar nada.
# mysql: usa tu servidor MySQL con la base sakila cargada (sakila-schema.sql y sakila-data.sql).
DB_TYPE=sqlite
SQLITE_PATH=./db/sakila.db

# Solo si DB_TYPE=mysql (en XAMPP el usuario es root y la contraseña va vacía)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sakila
