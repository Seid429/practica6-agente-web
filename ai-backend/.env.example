PORT=3000

# Copia este archivo como ".env" y pega tu API key de OpenRouter abajo.
# Se obtiene en https://openrouter.ai/keys y empieza con "sk-or-v1-..."
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui

# Modelo a usar (opcional). Ejemplos: openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini
